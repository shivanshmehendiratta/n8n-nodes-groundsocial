{
	"name": "n8n-nodes-groundsocial",
	"version": "0.1.0",
	"description": "n8n node for Groundsocial: public posts, comments, profiles, transcripts and search from 80+ platforms",
	"license": "MIT",
	"homepage": "https://github.com/shivanshmehendiratta/n8n-nodes-groundsocial",
	"keywords": [
		"n8n-community-node-package",
		"groundsocial",
		"reddit",
		"youtube",
		"twitter",
		"social media",
		"scraping"
	],
	"author": {
		"name": "Shivansh Mehendiratta",
		"email": "hello@groundsocial.dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/shivanshmehendiratta/n8n-nodes-groundsocial.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/GroundsocialApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Groundsocial/Groundsocial.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^1.3.0",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
